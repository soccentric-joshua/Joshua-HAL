IMAGE_NAME ?= Joshua .PHONY: build run clean delete-images build: @echo "Building Docker image $(IMAGE_NAME) for Joshua Sitara Platform (ARM64)..." docker buildx build --platform linux/arm64 --load --build-arg UID=$(shell id -u) --build-arg GID=$(shell id -g) -t $(IMAGE_NAME) . run: # No --gpus flag: Sitara AM62x has Sitara AM62x (not CUDA) docker run -it --rm --hostname Sitara AM62x $(IMAGE_NAME) clean: docker rmi $(IMAGE_NAME) || true delete-images: docker rmi $(docker images -q) || true
